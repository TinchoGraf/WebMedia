# ─── Perfil de la demo: "autos" o "propiedades" ───────────────────────────
PERFIL=autos

# ─── Base de datos ─────────────────────────────────────────────────────────
# Vacía = usa PGlite (Postgres embebido) en .data/pglite: sirve para probar sin instalar nada.
# Producción: la connection string POOLED de Neon (con -pooler en el host), usuario de la app.
DATABASE_URL=
# Solo para migraciones: usuario dueño del esquema (no la uses en la app)
DATABASE_URL_MIGRACIONES=

# ─── Auth ──────────────────────────────────────────────────────────────────
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Usuarios que crea el seed (cambiar antes de mostrar la demo)
SEED_DUENO_EMAIL=dueno@demo.local
SEED_DUENO_PASSWORD=
SEED_DEMO_PASSWORD=

# ─── Fotos ─────────────────────────────────────────────────────────────────
# Vacío = se guardan en .data/media (solo local). En Vercel: token de un Blob store.
BLOB_READ_WRITE_TOKEN=

# ─── Email (opcional) ──────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_AVISOS=

# ─── Cron de reinicio del modo demo ────────────────────────────────────────
CRON_SECRET=
